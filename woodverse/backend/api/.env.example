# WoodVerse API Environment Variables
# Copy this file to .env for local development

# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-32-character-string

# Frontend (comma-separated)
WEB_ORIGIN=http://localhost:5173,http://localhost:5174

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=replace-with-same-key-as-ai-service

# Supabase PostgreSQL (pooler URL, port 5432 or 6543)
DATABASE_URL=postgresql://postgres.yemndkmrtblklqkleuzk:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_POOL_SIZE=10

# Optional: override auto-detected Supabase pooler host
# SUPABASE_POOLER_HOST=aws-0-ap-southeast-2.pooler.supabase.com
