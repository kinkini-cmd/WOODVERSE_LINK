{
  "name": "woodverse",
  "version": "1.0.0",
  "private": true,
  "description": "WoodVerse - AI-assisted multi-vendor woodcraft platform",
  "workspaces": [
    "frontend",
    "backend/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:ai\"",
    "dev:api": "npm run dev --workspace=backend/api",
    "dev:web": "npm run dev --workspace=frontend",
    "dev:ai": "cd backend/ai-service && uvicorn src.main:app --host 0.0.0.0 --port 8000 --reload",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend/api",
    "install:all": "npm install",
    "test": "npm run test --workspace=frontend && npm run test --workspace=backend/api",
    "test:frontend": "npm run test --workspace=frontend",
    "test:api": "npm run test --workspace=backend/api",
    "test:ai": "cd backend/ai-service && python3 -m pytest tests/ -q",
    "test:ai:e2e": "cd backend/ai-service && ./tests/e2e.sh",
    "test:checkout:e2e": "./backend/api/tests/checkout.e2e.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
